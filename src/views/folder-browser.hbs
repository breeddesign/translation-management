<div class="flex h-[calc(100vh-3.5rem)]">

  <!-- Sidebar: Folder Tree -->
  <aside class="w-72 border-r border-gray-200 bg-gray-50 overflow-y-auto flex-shrink-0">
    <div class="p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Ordner</h2>
        <button
          onclick="document.getElementById('new-root-folder').classList.toggle('hidden')"
          class="text-gray-400 hover:text-blue-600 leading-none" title="Neuen Ordner erstellen"><span class="material-symbols-rounded">create_new_folder</span></button>
      </div>

      <!-- Inline form: new root folder -->
      <form id="new-root-folder" class="hidden mb-3"
        hx-post="/api/folders"
        hx-headers='{"Content-Type": "application/json"}'
        hx-ext="json-enc"
        hx-target="body" hx-swap="innerHTML">
        <div class="flex gap-1">
          <input type="text" name="name" placeholder="Ordnername" required
            class="flex-1 rounded border border-gray-300 px-2 py-1 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
          <button type="submit" class="rounded bg-blue-600 px-2 py-1 text-xs text-white hover:bg-blue-700">OK</button>
        </div>
      </form>

      <!-- Folder search -->
      <div class="relative mb-3">
        <span class="material-symbols-rounded absolute left-2 top-1.5 text-gray-400" style="font-size:16px">search</span>
        <input type="search" id="folder-search" placeholder="Ordner suchen…" autocomplete="off"
          oninput="filterFolderTree(this.value)"
          class="w-full rounded-lg border border-gray-300 pl-7 pr-2 py-1.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
      </div>

      <!-- Folder tree — wird nachgeladen, damit die Seite sofort erscheint
           (der vollständige HeyGen-Baum braucht beim ersten Mal einige Sekunden) -->
      <nav>
        <ul id="folder-tree" class="space-y-0.5"
          hx-get="/partials/folder-tree" hx-trigger="load" hx-swap="innerHTML">
          <li class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-400">
            <span class="material-symbols-rounded animate-spin" style="font-size:16px">progress_activity</span>
            Ordner werden geladen…
          </li>
        </ul>
      </nav>
    </div>
  </aside>

  <!-- Content column: video search + selected folder -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Video search (global, all folders) -->
    <div class="border-b border-gray-200 bg-white px-6 py-3 flex-shrink-0">
      <div class="relative max-w-md">
        <span class="material-symbols-rounded absolute left-2.5 top-2 text-gray-400" style="font-size:18px">search</span>
        <input type="search" name="q" placeholder="Videos suchen (alle Ordner)…" autocomplete="off"
          hx-get="/search/videos" hx-trigger="input changed delay:400ms, search" hx-target="#folder-content" hx-swap="innerHTML"
          class="w-full rounded-lg border border-gray-300 pl-8 pr-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
      </div>
    </div>

    <main id="folder-content" class="flex-1 overflow-y-auto p-6">
      {{#if selectedFolderId}}
      <div hx-get="/folders/{{selectedFolderId}}" hx-trigger="load" hx-swap="innerHTML"></div>
      {{else}}
      <div class="flex flex-col items-center justify-center h-full text-gray-400">
        <span class="material-symbols-rounded" style="font-size:64px">folder_open</span>
        <p class="text-lg font-medium">Ordner auswählen</p>
        <p class="text-sm mt-1">Klicke links auf einen Ordner — oder suche oben nach Videos.</p>
      </div>
      {{/if}}
    </main>
  </div>
</div>

<div id="modal"></div>

<script>
// ── Ordnerbaum filtern (Treffer + Vorfahren zeigen, Pfade aufklappen) ──
function filterFolderTree(query) {
  const q = query.trim().toLowerCase();
  const tree = document.getElementById("folder-tree");
  const items = tree.querySelectorAll("li[data-tree-item]");

  if (!q) {
    items.forEach((li) => { li.style.display = ""; });
    tree.querySelectorAll("ul").forEach((ul) => ul.classList.add("hidden"));
    tree.querySelectorAll(".tree-chevron").forEach((ch) => ch.classList.remove("rotate-90"));
    return;
  }

  items.forEach((li) => { li.style.display = "none"; });
  items.forEach((li) => {
    if ((li.dataset.name || "").toLowerCase().includes(q)) {
      let el = li;
      while (el && el !== tree) {
        if (el.tagName === "LI") el.style.display = "";
        if (el.tagName === "UL") {
          el.classList.remove("hidden");
          const chevron = el.closest("li")?.querySelector(".tree-chevron");
          if (chevron) chevron.classList.add("rotate-90");
        }
        el = el.parentElement;
      }
    }
  });
}
</script>
