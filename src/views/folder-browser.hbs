<div class="flex h-[calc(100vh-3.5rem)]">

  <!-- Sidebar: Folder Tree -->
  <aside class="w-72 border-r border-gray-200 bg-gray-50 overflow-y-auto flex-shrink-0">
    <div class="p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Ordner</h2>
        <button
          onclick="document.getElementById('new-root-folder').classList.toggle('hidden')"
          class="text-gray-400 hover:text-blue-600 leading-none" title="Neuen Ordner erstellen"><span class="material-symbols-rounded">create_new_folder</span></button>
      </div>

      <!-- Inline form: new root folder -->
      <form id="new-root-folder" class="hidden mb-3"
        hx-post="/api/folders"
        hx-headers='{"Content-Type": "application/json"}'
        hx-ext="json-enc"
        hx-target="body" hx-swap="innerHTML">
        <div class="flex gap-1">
          <input type="text" name="name" placeholder="Ordnername" required
            class="flex-1 rounded border border-gray-300 px-2 py-1 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
          <button type="submit" class="rounded bg-blue-600 px-2 py-1 text-xs text-white hover:bg-blue-700">OK</button>
        </div>
      </form>

      <!-- Folder tree -->
      <nav>
        <ul class="space-y-0.5">
          {{#each tree}}
          {{> folderTreeItem this}}
          {{/each}}
        </ul>
      </nav>
    </div>
  </aside>

  <!-- Content: Selected folder -->
  <main id="folder-content" class="flex-1 overflow-y-auto p-6">
    {{#if selectedFolderId}}
    <div hx-get="/folders/{{selectedFolderId}}" hx-trigger="load" hx-swap="innerHTML"></div>
    {{else}}
    <div class="flex flex-col items-center justify-center h-full text-gray-400">
      <span class="material-symbols-rounded" style="font-size:64px">folder_open</span>
      <p class="text-lg font-medium">Ordner auswählen</p>
      <p class="text-sm mt-1">Klicke links auf einen Ordner, um den Inhalt anzuzeigen.</p>
    </div>
    {{/if}}
  </main>
</div>

<div id="modal"></div>
