<!-- Project Detail -->
<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
<div class="mb-6">
  <a href="javascript:history.back()" class="text-sm text-gray-500 hover:text-gray-700"><span class="material-symbols-rounded" style="font-size:16px">arrow_back</span> Zurück</a>
</div>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">{{project.name}}</h1>
    <p class="text-sm text-gray-500 mt-1">
      {{{statusBadge project.status}}}
      · {{videoCount}} Videos · {{languages.length}} Sprachen
      · Storage: {{storageProvider}}
    </p>
  </div>
  <div class="flex gap-2">
    <button
      hx-get="/projects/{{project.id}}/settings"
      hx-target="#modal"
      class="rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50"
    ><span class="material-symbols-rounded">settings</span> Einstellungen</button>
    <button
      hx-delete="/api/projects/{{project.id}}"
      hx-confirm="Projekt '{{project.name}}' und alle zugehörigen Daten unwiderruflich löschen?"
      hx-swap="none"
      class="rounded-lg border border-red-300 px-3 py-2 text-sm text-red-600 hover:bg-red-50"
    >Projekt löschen</button>
  </div>
</div>

<!-- Status Overview (SMART polling: fast when active, slow when idle) -->
<div
  id="status-bar"
  hx-get="/partials/projects/{{project.id}}/status"
  hx-trigger="load, pollStatus"
  hx-swap="innerHTML"
  class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8"
>
  {{> status-cards}}
</div>

<!-- Tabs -->
<div class="border-b border-gray-200 mb-6">
  <nav class="flex gap-6" id="tabs">
    <button onclick="showTab('videos')" class="tab-btn pb-3 text-sm font-medium border-b-2 border-blue-600 text-blue-600" data-tab="videos">
      <span class="material-symbols-rounded">videocam</span> Videos ({{videoCount}})
    </button>
    <button onclick="showTab('proofreads')" class="tab-btn pb-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="proofreads">
      <span class="material-symbols-rounded">edit_note</span> Proofreads ({{proofreadCount}})
    </button>
    <button onclick="showTab('translated')" class="tab-btn pb-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-tab="translated">
      <span class="material-symbols-rounded">translate</span> Übersetzungen ({{translatedCount}})
    </button>
  </nav>
</div>

<!-- Tab: Videos -->
<div id="tab-videos" class="tab-content">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">Videos</h2>
    <div class="flex gap-2">
      <button
        hx-get="/projects/{{project.id}}/videos/upload"
        hx-target="#modal"
        class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white hover:bg-blue-700"
      ><span class="material-symbols-rounded">add</span> Videos hinzufügen</button>
      {{#if videoCount}}
      <button
        hx-post="/api/projects/{{project.id}}/proofreads/generate"
        hx-confirm="Proofreads für alle Videos generieren?"
        hx-swap="none"
        hx-disabled-elt="this"
        class="rounded-lg bg-green-600 px-3 py-2 text-sm font-medium text-white hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed"
      ><span class="material-symbols-rounded">play_arrow</span> Proofreads generieren</button>
      {{/if}}
    </div>
  </div>

  {{#if videos.length}}
  <!-- Batch action bar for videos -->
  <div id="video-batch-bar" class="hidden mb-2 flex items-center gap-3 px-4 py-2 bg-blue-50 border border-blue-200 rounded-lg">
    <span class="text-sm text-blue-800"><strong id="video-batch-count">0</strong> ausgewählt</span>
    <button onclick="batchDeleteVideos()" class="text-xs px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700">Ausgewählte löschen</button>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 w-8"><input type="checkbox" id="video-select-all" onchange="toggleAll('video-cb', this.checked)" class="rounded border-gray-300"></th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Titel</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Datei</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Erstellt</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {{#each videos}}
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3"><input type="checkbox" class="video-cb rounded border-gray-300" value="{{this.id}}" onchange="updateBatchBar('video')"></td>
          <td class="px-4 py-3 text-sm font-medium text-gray-900">{{this.title}}</td>
          <td class="px-4 py-3 text-sm text-gray-500">{{this.original_filename}}</td>
          <td class="px-4 py-3">{{{statusBadge this.status}}}</td>
          <td class="px-4 py-3 text-sm text-gray-500">{{formatDate this.created_at}}</td>
          <td class="px-4 py-3 text-right">
            <button
              hx-delete="/api/projects/{{../project.id}}/videos/{{this.id}}"
              hx-confirm="Video '{{this.title}}' und alle zugehörigen Proofreads löschen?"
              hx-swap="none"
              class="text-xs text-red-500 hover:text-red-700"
            >Löschen</button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
    <p class="text-gray-500 mb-4">Noch keine Videos hochgeladen.</p>
  </div>
  {{/if}}
</div>

<!-- Tab: Proofreads -->
<div id="tab-proofreads" class="tab-content hidden">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">Proofreads</h2>
    {{#if hasEditedProofreads}}
    <button
      hx-post="/api/projects/{{project.id}}/videos/generate"
      hx-confirm="Videos für alle editierten Proofreads generieren?"
      hx-swap="none"
      class="rounded-lg bg-green-600 px-3 py-2 text-sm font-medium text-white hover:bg-green-700"
    ><span class="material-symbols-rounded">play_arrow</span> Videos generieren</button>
    {{/if}}
  </div>

  <div
    id="proofreads-table"
    hx-get="/partials/projects/{{project.id}}/proofreads"
    hx-trigger="pollStatus"
    hx-swap="innerHTML"
  >
    {{> proofreads-table}}
  </div>
</div>

<!-- Tab: Translated -->
<div id="tab-translated" class="tab-content hidden">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">Übersetzte Videos</h2>
    {{#if hasCompletedTranslations}}
    <div class="flex items-center gap-2">
      <button
        hx-post="/api/projects/{{project.id}}/pull-assets"
        hx-swap="none"
        class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
      ><span class="material-symbols-rounded">cloud_download</span> Assets von HeyGen ziehen</button>
      <a
        href="/api/projects/{{project.id}}/downloads"
        class="rounded-lg bg-gray-800 px-3 py-2 text-sm font-medium text-white hover:bg-gray-900"
      ><span class="material-symbols-rounded">download</span> Download-Links (JSON)</a>
    </div>
    {{/if}}
  </div>

  <div
    id="translated-table"
    hx-get="/partials/projects/{{project.id}}/translated"
    hx-trigger="pollStatus"
    hx-swap="innerHTML"
  >
    {{> translated-table}}
  </div>
</div>

<div id="modal"></div>

<script>
// ── Smart Polling ───────────────────────────────────────────
// 3s when jobs are active, 30s when idle
let pollInterval = {{#if hasActiveJobs}}3000{{else}}30000{{/if}};
let pollTimer = null;

function schedulePoll() {
  if (pollTimer) clearTimeout(pollTimer);
  pollTimer = setTimeout(() => {
    htmx.trigger('#status-bar', 'pollStatus');
    schedulePoll();
  }, pollInterval);
}

// Listen to status response to adjust interval
document.body.addEventListener('htmx:afterSettle', (evt) => {
  if (evt.detail.target?.id === 'status-bar') {
    // Check if response contains hasActiveJobs flag
    const html = evt.detail.target.innerHTML;
    const hasActive = html.includes('data-active="true"');
    const newInterval = hasActive ? 3000 : 30000;
    if (newInterval !== pollInterval) {
      pollInterval = newInterval;
      console.log(`Polling interval: ${pollInterval}ms`);
    }
  }
});

schedulePoll();

// ── Tabs ────────────────────────────────────────────────────
function showTab(name) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.classList.remove('border-blue-600', 'text-blue-600');
    btn.classList.add('border-transparent', 'text-gray-500');
  });
  document.getElementById('tab-' + name).classList.remove('hidden');
  const btn = document.querySelector(`[data-tab="${name}"]`);
  btn.classList.add('border-blue-600', 'text-blue-600');
  btn.classList.remove('border-transparent', 'text-gray-500');
}

// ── Batch Select ────────────────────────────────────────────
function toggleAll(cbClass, checked) {
  document.querySelectorAll('.' + cbClass).forEach(cb => cb.checked = checked);
  updateBatchBar(cbClass.replace('-cb', ''));
}

function getSelectedIds(cbClass) {
  return Array.from(document.querySelectorAll('.' + cbClass + ':checked')).map(cb => cb.value);
}

function updateBatchBar(prefix) {
  const ids = getSelectedIds(prefix + '-cb');
  const bar = document.getElementById(prefix + '-batch-bar');
  const count = document.getElementById(prefix + '-batch-count');
  if (!bar) return;
  if (ids.length > 0) {
    bar.classList.remove('hidden');
    bar.classList.add('flex');
    count.textContent = ids.length;
  } else {
    bar.classList.add('hidden');
    bar.classList.remove('flex');
  }
  // Update "select all" checkbox state
  const selectAll = document.getElementById(prefix + '-select-all');
  if (selectAll) {
    const total = document.querySelectorAll('.' + prefix + '-cb').length;
    selectAll.checked = ids.length === total && total > 0;
    selectAll.indeterminate = ids.length > 0 && ids.length < total;
  }
}

async function batchDeleteVideos() {
  const ids = getSelectedIds('video-cb');
  if (!ids.length) return;
  if (!confirm(`${ids.length} Video(s) und zugehörige Proofreads löschen?`)) return;
  const res = await fetch('/api/projects/{{project.id}}/videos/batch-delete', {
    method: 'POST', headers: { 'Content-Type': 'application/json', 'HX-Request': 'true' },
    body: JSON.stringify({ ids })
  });
  if (res.ok) window.location.reload();
}

async function batchDeleteProofreads() {
  const ids = getSelectedIds('proofread-cb');
  if (!ids.length) return;
  if (!confirm(`${ids.length} Proofread(s) löschen?`)) return;
  const res = await fetch('/api/proofreads/batch-delete', {
    method: 'POST', headers: { 'Content-Type': 'application/json', 'HX-Request': 'true' },
    body: JSON.stringify({ ids })
  });
  if (res.ok) window.location.reload();
}

async function batchSyncProofreads() {
  const ids = getSelectedIds('proofread-cb');
  if (!ids.length) return;
  const res = await fetch('/api/proofreads/batch-sync', {
    method: 'POST', headers: { 'Content-Type': 'application/json', 'HX-Request': 'true' },
    body: JSON.stringify({ ids })
  });
  if (res.ok) htmx.trigger('#status-bar', 'pollStatus');
}

async function batchDownloadProofreads() {
  const ids = getSelectedIds('proofread-cb');
  if (!ids.length) return;
  const res = await fetch('/api/proofreads/batch-download', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids })
  });
  if (!res.ok) return;
  const data = await res.json();
  // Open each download URL in sequence
  for (const d of data.downloads) {
    window.open(d.url, '_blank');
  }
}
</script>
</div>
