<!DOCTYPE html>
<html lang="de" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HeyGen Proofreader</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&display=swap">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="https://unpkg.com/htmx-ext-response-targets@2.0.2/response-targets.js"></script>
  <script src="https://unpkg.com/htmx-ext-json-enc@2.0.1/json-enc.js"></script>
  <style>
    .htmx-indicator { display: none; }
    .htmx-request .htmx-indicator { display: inline-block; }
    .htmx-request.htmx-indicator { display: inline-block; }
    .material-symbols-rounded { font-size: 18px; vertical-align: middle; }
  </style>
</head>
<body class="h-full" hx-ext="response-targets">
  <div class="min-h-full flex flex-col">
    <!-- Nav -->
    <nav class="bg-white border-b border-gray-200 flex-shrink-0">
      <div class="px-4 sm:px-6">
        <div class="flex h-14 items-center justify-between">
          <a href="/" class="flex items-center gap-2 text-lg font-semibold text-gray-900">
            HeyGen Proofreader
          </a>
          <div class="flex items-center gap-4">
            <a href="/" class="text-sm text-gray-600 hover:text-gray-900">Ordner</a>
            <a href="/jobs" class="text-sm text-gray-600 hover:text-gray-900">Jobs</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Content -->
    <main>
      {{{body}}}
    </main>
  </div>
</body>
</html>
