{{#if proofreads.length}}
<!-- Batch action bar for proofreads -->
<div id="proofread-batch-bar" class="hidden mb-2 flex items-center gap-3 px-4 py-2 bg-blue-50 border border-blue-200 rounded-lg">
  <span class="text-sm text-blue-800"><strong id="proofread-batch-count">0</strong> ausgewählt</span>
  <button onclick="batchDeleteProofreads()" class="text-xs px-2 py-1 bg-red-600 text-white rounded hover:bg-red-700">Ausgewählte löschen</button>
  <button onclick="batchSyncProofreads()" class="text-xs px-2 py-1 bg-blue-600 text-white rounded hover:bg-blue-700">Status prüfen</button>
  <button onclick="batchDownloadProofreads()" class="text-xs px-2 py-1 bg-gray-700 text-white rounded hover:bg-gray-800"><span class="material-symbols-rounded" style="font-size:14px">download</span> Excel herunterladen</button>
</div>
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 w-8"><input type="checkbox" id="proofread-select-all" onchange="toggleAll('proofread-cb', this.checked)" class="rounded border-gray-300"></th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Video</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Sprache</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Rev.</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Aktionen</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      {{#each proofreads}}
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3"><input type="checkbox" class="proofread-cb rounded border-gray-300" value="{{this.id}}" onchange="updateBatchBar('proofread')"></td>
        <td class="px-4 py-3 text-sm font-medium text-gray-900">{{this.video_title}}</td>
        <td class="px-4 py-3 text-sm text-gray-600">{{this.language}}</td>
        <td class="px-4 py-3">{{{statusBadge this.status}}}</td>
        <td class="px-4 py-3 text-sm text-gray-500">
          {{#if this.excel_revision}}v{{this.excel_revision}}{{else}}–{{/if}}
        </td>
        <td class="px-4 py-3">
          <div class="flex gap-2">
            {{#if (eq this.status "completed")}}
            <a href="/api/proofreads/{{this.id}}/excel" class="text-xs text-blue-600 hover:underline"><span class="material-symbols-rounded" style="font-size:14px">download</span> Excel</a>
            <button hx-get="/projects/{{this.project_id}}/proofreads/{{this.id}}/upload" hx-target="#modal" class="text-xs text-green-600 hover:underline"><span class="material-symbols-rounded" style="font-size:14px">upload</span> Upload</button>
            {{/if}}
            {{#if (eq this.status "edited")}}
            <a href="/api/proofreads/{{this.id}}/excel" class="text-xs text-blue-600 hover:underline"><span class="material-symbols-rounded" style="font-size:14px">download</span> Excel</a>
            <button hx-get="/projects/{{this.project_id}}/proofreads/{{this.id}}/upload" hx-target="#modal" class="text-xs text-green-600 hover:underline"><span class="material-symbols-rounded" style="font-size:14px">upload</span> Re-Upload</button>
            <span class="text-xs text-yellow-600"><span class="material-symbols-rounded" style="font-size:14px">check</span> Editiert</span>
            {{/if}}
            {{#if (eq this.status "done")}}
            <span class="text-xs text-emerald-600"><span class="material-symbols-rounded" style="font-size:14px">check_circle</span> Fertig</span>
            {{/if}}
            {{#if (eq this.status "failed")}}
            <span class="text-xs text-red-600" title="{{this.error_message}}"><span class="material-symbols-rounded" style="font-size:14px">error</span> Fehler</span>
            <button hx-post="/api/proofreads/{{this.id}}/retry" hx-swap="none" class="text-xs text-blue-600 hover:underline"><span class="material-symbols-rounded" style="font-size:14px">refresh</span> Retry</button>
            {{/if}}
            {{#if (eq this.status "processing")}}
            <span class="text-xs text-gray-400"><span class="material-symbols-rounded" style="font-size:14px">hourglass_top</span> Verarbeitung...</span>
            <button hx-post="/api/proofreads/{{this.id}}/sync" hx-swap="none" class="text-xs text-blue-600 hover:underline"><span class="material-symbols-rounded" style="font-size:14px">sync</span> Status prüfen</button>
            {{/if}}
            {{#if (eq this.status "pending")}}
            <span class="text-xs text-gray-400"><span class="material-symbols-rounded" style="font-size:14px">schedule</span> Warteschlange...</span>
            {{/if}}
            {{#if (eq this.status "generating")}}
            <span class="text-xs text-purple-500"><span class="material-symbols-rounded" style="font-size:14px">hourglass_top</span> Video wird erzeugt...</span>
            {{/if}}
            <button
              hx-delete="/api/proofreads/{{this.id}}"
              hx-confirm="Proofread '{{this.video_title}} ({{this.language}})' löschen?"
              hx-swap="none"
              class="text-xs text-red-500 hover:text-red-700"
            >Löschen</button>
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<div class="text-center py-12 bg-white rounded-xl border border-gray-200">
  <p class="text-gray-500">Noch keine Proofreads. Erst Videos hinzufügen, dann "Proofreads generieren" klicken.</p>
</div>
{{/if}}
