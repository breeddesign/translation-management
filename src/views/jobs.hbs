<div class="max-w-6xl mx-auto p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-gray-900">Jobs</h1>
    <button onclick="location.reload()"
      class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50">
      <span class="material-symbols-rounded" style="font-size:16px">refresh</span> Aktualisieren
    </button>
  </div>

  <!-- Queue Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-8">
    {{#each queueStats}}
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">{{this.name}}</p>
      <div class="space-y-1 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">Wartend</span><span class="font-medium">{{this.waiting}}</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Aktiv</span><span class="font-medium text-blue-600">{{this.active}}</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Verzögert</span><span class="font-medium">{{this.delayed}}</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Fertig</span><span class="font-medium text-green-600">{{this.completed}}</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Fehler</span><span class="font-medium text-red-600">{{this.failed}}</span></div>
      </div>
    </div>
    {{/each}}
  </div>

  <!-- Failed Jobs -->
  {{#if hasFailedJobs}}
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Fehlgeschlagene Jobs</h2>
  <div class="bg-white rounded-xl border border-red-200 overflow-hidden mb-8">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-red-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Queue</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Job</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Versuche</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Fehler</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {{#each failedJobs}}
        <tr>
          <td class="px-4 py-2 text-sm text-gray-600">{{this.queue}}</td>
          <td class="px-4 py-2 text-sm font-medium text-gray-900" title="{{this.data}}">{{this.job_name}}</td>
          <td class="px-4 py-2 text-sm text-gray-600">{{this.attempts}}</td>
          <td class="px-4 py-2 text-xs text-red-600 font-mono">{{this.reason}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Job Log -->
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-2">Job-Log (letzte 50)</h2>
  {{#if hasJobLog}}
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Zeit</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Typ</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Referenz</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Nachricht</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {{#each jobLog}}
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-2 text-xs text-gray-500 whitespace-nowrap">{{formatDate this.created_at}}</td>
          <td class="px-4 py-2 text-sm text-gray-900">{{this.job_type}}</td>
          <td class="px-4 py-2 text-xs text-gray-500 font-mono">{{this.reference_id}}</td>
          <td class="px-4 py-2">{{{statusBadge this.status}}}</td>
          <td class="px-4 py-2 text-sm text-gray-600">{{this.message}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="text-center py-12 bg-white rounded-xl border border-gray-200">
    <p class="text-gray-500">Noch keine Job-Einträge.</p>
  </div>
  {{/if}}
</div>
