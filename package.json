{
  "name": "heygen-proofreader",
  "version": "2.0.0",
  "description": "Batch-Video-Übersetzung und Proofread-Management für die HeyGen API",
  "author": "Tobias <tb@breed.design>",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "tsx watch src/web.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:worker\"",
    "dev:desktop": "APP_MODE=desktop PORT=3010 tsx watch src/desktop.ts",
    "build": "tsc && npm run build:css && node scripts/build-icon-font.mjs && node scripts/copy-assets.mjs",
    "build:css": "tailwindcss -i src/styles/app.css -o public/static/app.css --minify",
    "start:web": "node dist/web.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "desktop": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "desktop:rebuild": "electron-builder install-app-deps",
    "desktop:rebuild-node": "npm rebuild better-sqlite3",
    "icon": "node scripts/make-icon.mjs",
    "dist:mac": "npm run build && npm run icon && env -u ELECTRON_RUN_AS_NODE electron-builder --mac -c.directories.output=$HOME/Builds/heygen-proofreader"
  },
  "build": {
    "appId": "design.breed.heygen-proofreader",
    "productName": "HeyGen Proofreader",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "desktop/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "public/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "desktop/build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "npmRebuild": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "@microsoft/microsoft-graph-client": "^3.0.0",
    "archiver": "^7.0.0",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.30.0",
    "dotenv": "^16.4.0",
    "dropbox": "^10.34.0",
    "exceljs": "^4.4.0",
    "googleapis": "^144.0.0",
    "handlebars": "^4.7.0",
    "hono": "^4.7.0",
    "ioredis": "^5.4.0",
    "isomorphic-fetch": "^3.0.0",
    "kysely": "^0.27.0",
    "mysql2": "^3.11.0",
    "nanoid": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "htmx-ext-json-enc": "^2.0.1",
    "htmx-ext-response-targets": "^2.0.2",
    "htmx.org": "^2.0.4",
    "material-symbols": "^0.46.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
