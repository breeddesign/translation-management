{
  "name": "heygen-proofreader",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/web.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:worker\"",
    "build": "tsc",
    "start:web": "node dist/web.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@hono/node-server": "^1.13.0",
    "bullmq": "^5.30.0",
    "ioredis": "^5.4.0",
    "mysql2": "^3.11.0",
    "kysely": "^0.27.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "dropbox": "^10.34.0",
    "googleapis": "^144.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.0",
    "isomorphic-fetch": "^3.0.0",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0",
    "nanoid": "^5.0.0",
    "archiver": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "concurrently": "^9.1.0",
    "@types/node": "^22.0.0",
    "@types/archiver": "^6.0.0"
  }
}
