# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MySQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=heygen_proofreader

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── HeyGen API ───────────────────────────────────────────────
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_MAX_CONCURRENCY=5
HEYGEN_REQUESTS_PER_MINUTE=30

# ── Storage ───────────────────────────────────────────────────
# Options: local, r2, dropbox, google_drive, onedrive
STORAGE_PROVIDER=local

# Local Storage
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_BASE_URL=http://localhost:3000/files

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=heygen-proofreader

# Dropbox
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_FOLDER=/heygen-proofreader

# Google Drive (Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# OneDrive (App Registration)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_FOLDER=/heygen-proofreader

# ── Session ───────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_random_string_at_least_16_chars
